// ==UserScript==
// @name         Coda Task Logger (Memory + Manual Export)
// @namespace    mxm-tools
// @version      1.2.0
// @description  Stores Coda task logs in Tampermonkey memory and lets you download them anytime.
// @author       Richie
// @match        https://coda.io/*
// @run-at       document-end
// @noframes     false
// @grant        unsafeWindow
// @grant        GM_setClipboard
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_download
// ==/UserScript==

(function () {
  'use strict';

  const LOG_KEY_PREFIX = 'coda_task_log::';
  const WINDOW_STATE_KEY = 'coda_task_log_window_state';
  const DEFAULT_FILE_EXTENSION = '.json';
  const DEBUG = true;
  const STABILITY_CHECKS = 12;
  const STABILITY_INTERVAL = 150;
  const FRAME_REATTACH_INTERVAL = 3000;
  const ELEMENT_NODE = typeof Node !== 'undefined' ? Node.ELEMENT_NODE : 1;

  const attachedDocuments = new WeakSet();
  const observedDocuments = new WeakMap();
  const processedIframes = new WeakSet();
  const hostWindow = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

  const COLUMN_KEYWORDS = {
    isrc: ['isrc', 'isrc code', 'isrc#'],
    artist: [
      'artist',
      'artist name',
      'primary artist',
      'main artist',
      'performer',
      'creator',
      'writer',
    ],
    title: [
      'title',
      'title name',
      'track name',
      'song title',
      'track',
      'track title',
    ],
  };

  function matchesKeyword(candidate, keywords) {
    return keywords.some((keyword) => candidate.includes(keyword));
  }

  // ---------- Helpers ----------
  const ts = (date = new Date()) => {
    const d = date instanceof Date ? date : new Date(date);
    const p = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
  };

  function readStorage(key, fallback = '') {
    try {
      if (typeof GM_getValue === 'function') {
        return GM_getValue(key, fallback);
      }
    } catch (err) {
      console.warn('[Coda Logger] GM_getValue failed, falling back to localStorage.', err);
    }

    try {
      const value = localStorage.getItem(key);
      return value === null ? fallback : value;
    } catch (err) {
      console.error('[Coda Logger] Failed to read from localStorage:', err);
      return fallback;
    }
  }

  function writeStorage(key, value) {
    try {
      if (typeof GM_setValue === 'function') {
        GM_setValue(key, value);
        return;
      }
    } catch (err) {
      console.warn('[Coda Logger] GM_setValue failed, falling back to localStorage.', err);
    }

    try {
      localStorage.setItem(key, value);
    } catch (err) {
      console.error('[Coda Logger] Failed to write to localStorage:', err);
    }
  }

  function getCurrentNMFWindow(referenceDate = new Date()) {
    const now = referenceDate instanceof Date ? new Date(referenceDate.getTime()) : new Date(referenceDate);
    const day = now.getDay();

    const currentThursday = new Date(now);
    currentThursday.setDate(now.getDate() - ((day + 7 - 4) % 7));
    currentThursday.setHours(15, 0, 0, 0);

    if (now < currentThursday) {
      currentThursday.setDate(currentThursday.getDate() - 7);
    }

    const nextThursday = new Date(currentThursday);
    nextThursday.setDate(nextThursday.getDate() + 7);
    nextThursday.setHours(15, 0, 0, 0);

    return { start: currentThursday, end: nextThursday };
  }

  function getNMFFileName(referenceDate = new Date()) {
    const { start } = getCurrentNMFWindow(referenceDate);
    const friday = new Date(start);
    friday.setDate(start.getDate() + 1);

    const day = String(friday.getDate()).padStart(2, '0');
    const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short' });
    const month = monthFormatter.format(friday);

    return `NMF-${day}${month}`;
  }

  function getActiveLogContext(referenceDate = new Date()) {
    const { start, end } = getCurrentNMFWindow(referenceDate);
    const fileName = getNMFFileName(referenceDate);
    const logKey = `${LOG_KEY_PREFIX}${fileName}`;

    const payload = {
      start: start.toISOString(),
      end: end.toISOString(),
      fileName,
      logKey,
    };

    try {
      const cachedRaw = readStorage(WINDOW_STATE_KEY, '');
      if (!cachedRaw) {
        writeStorage(WINDOW_STATE_KEY, JSON.stringify(payload));
      } else {
        try {
          const cached = JSON.parse(cachedRaw);
          if (
            cached?.logKey !== payload.logKey ||
            cached?.start !== payload.start ||
            cached?.end !== payload.end ||
            cached?.fileName !== payload.fileName
          ) {
            writeStorage(WINDOW_STATE_KEY, JSON.stringify(payload));
          }
        } catch (err) {
          console.warn('[Coda Logger] Failed to parse cached window state. Resetting.', err);
          writeStorage(WINDOW_STATE_KEY, JSON.stringify(payload));
        }
      }
    } catch (err) {
      console.warn('[Coda Logger] Unable to persist window state:', err);
    }

    return {
      start,
      end,
      fileName,
      logKey,
    };
  }

  function getActiveLogFile(referenceDate = new Date()) {
    const { fileName } = getActiveLogContext(referenceDate);
    return `${fileName}${DEFAULT_FILE_EXTENSION}`;
  }

  function normaliseWhitespace(value) {
    return (value || '').replace(/\s+/g, ' ').trim();
  }

  function isTopLevelContext() {
    try {
      return hostWindow.top === hostWindow.self;
    } catch (err) {
      return window.top === window.self;
    }
  }

  function attachClickListener(targetDoc, label = 'document') {
    if (!targetDoc || attachedDocuments.has(targetDoc)) {
      return;
    }

    targetDoc.addEventListener('click', handleClick, true);
    attachedDocuments.add(targetDoc);

    if (DEBUG) {
      console.log(`[Coda Logger] Attached click listener to ${label}.`);
    }
  }

  function observeDocumentForIframes(targetDoc) {
    if (!targetDoc || observedDocuments.has(targetDoc)) {
      return;
    }

    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        for (const node of mutation.addedNodes || []) {
          if (!node || node.nodeType !== ELEMENT_NODE) {
            continue;
          }

          if (node.tagName === 'IFRAME') {
            registerIframe(node);
          }

          const nestedIframes = node.querySelectorAll?.('iframe');
          if (nestedIframes && nestedIframes.length) {
            nestedIframes.forEach(registerIframe);
          }
        }
      }
    });

    observer.observe(targetDoc, { childList: true, subtree: true });
    observedDocuments.set(targetDoc, observer);
  }

  function isCodaIframe(iframe) {
    if (!iframe) return false;

    const src = iframe.getAttribute('src') || '';
    const id = iframe.id || '';
    const className = typeof iframe.className === 'string' ? iframe.className : '';
    const dataTestId = iframe.getAttribute('data-testid') || '';

    return (
      /coda\.io/i.test(src) ||
      /EmbedIframe/i.test(id) ||
      /FullPageEmbedIframe/i.test(id) ||
      /EmbedIframe/i.test(className) ||
      /FullPageEmbedIframe/i.test(className) ||
      /EmbedIframe/i.test(dataTestId) ||
      /FullPageEmbedIframe/i.test(dataTestId)
    );
  }

  function registerIframe(iframe) {
    if (!iframe || processedIframes.has(iframe) || !isCodaIframe(iframe)) {
      return;
    }

    processedIframes.add(iframe);

    const attach = () => {
      try {
        const iframeDoc = iframe.contentDocument || iframe.contentWindow?.document;
        if (!iframeDoc) {
          return;
        }

        attachClickListener(iframeDoc, 'iframe document');
        observeDocumentForIframes(iframeDoc);
      } catch (err) {
        console.error('[Coda Logger] Iframe access error:', err);
      }
    };

    attach();
    iframe.addEventListener('load', attach);
  }

  function attachToIframes(rootDoc = document) {
    if (!rootDoc) return;

    const iframes = rootDoc.querySelectorAll?.('iframe');
    if (!iframes || !iframes.length) {
      return;
    }

    iframes.forEach(registerIframe);
  }

  function initializeFrameBridging() {
    const label = isTopLevelContext() ? 'top document' : 'embedded document';
    attachClickListener(document, label);
    observeDocumentForIframes(document);
    attachToIframes(document);

    if (!hostWindow.__codaTaskLoggerFrameTimer) {
      hostWindow.__codaTaskLoggerFrameTimer = hostWindow.setInterval(() => {
        attachToIframes(document);
      }, FRAME_REATTACH_INTERVAL);
    }
  }

  function findRowElement(element) {
    if (!element) return null;
    return (
      element.closest('tr') ||
      element.closest('[role="row"]') ||
      element.closest('[data-row-id]') ||
      element.closest('[data-testid="canvas-view-row"]') ||
      null
    );
  }

  function getRowCells(row) {
    if (!row) return [];
    const selectors = [
      '[role="gridcell"]',
      'td',
      '[data-column-id]',
      '[data-testid="canvas-view-cell"]',
      '[data-testid="tableColumnCell"]',
    ];

    for (const selector of selectors) {
      const cells = Array.from(row.querySelectorAll(selector));
      if (cells.length) {
        return cells;
      }
    }

    // Fallback: use direct children
    return Array.from(row.children || []);
  }

  function detectByLabel(cell, text) {
    const candidate = [
      cell?.dataset?.columnId,
      cell?.dataset?.columnName,
      cell?.dataset?.columnLabel,
      cell?.getAttribute('data-column-id'),
      cell?.getAttribute('data-column-label'),
      cell?.getAttribute('aria-label'),
      text,
    ]
      .map((value) => value || '')
      .join(' ')
      .toLowerCase();

    return {
      isISRC:
        matchesKeyword(candidate, COLUMN_KEYWORDS.isrc) || /\bisrc\b/.test(candidate),
      isArtist: matchesKeyword(candidate, COLUMN_KEYWORDS.artist),
      isTitle: matchesKeyword(candidate, COLUMN_KEYWORDS.title),
    };
  }

  function extractRowData(row) {
    if (!row) return null;

    const cells = getRowCells(row);
    if (!cells.length) return null;

    const result = { isrc: '', artist: '', title: '' };

    const cellTexts = cells.map((cell) => normaliseWhitespace(cell.innerText || cell.textContent || ''));

    if (DEBUG) {
      console.log('[Coda Logger] Found cell texts:', cellTexts);
    }

    cells.forEach((cell, index) => {
      const text = cellTexts[index];
      if (!text) return;
      const { isISRC, isArtist, isTitle } = detectByLabel(cell, text);
      if (isISRC && !result.isrc) {
        result.isrc = text;
      } else if (isArtist && !result.artist) {
        result.artist = text;
      } else if (isTitle && !result.title) {
        result.title = text;
      }
    });

    const cleanedTexts = cellTexts.filter((text) => {
      if (!text) return false;
      if (/take\s+the\s+task/i.test(text)) return false;
      if (/close\s+task/i.test(text)) return false;
      if (/^\d+$/.test(text)) return false; // row index numbers
      return true;
    });

    const isrcPattern = /[A-Z]{2}-?[A-Z0-9]{3}-?\d{2}-?\d{5}/;
    if (!result.isrc) {
      const isrcCandidate = cleanedTexts.find((text) => isrcPattern.test(text.toUpperCase()));
      if (isrcCandidate) {
        result.isrc = isrcCandidate.toUpperCase();
      }
    }

    const remaining = cleanedTexts.filter((text) => text !== result.isrc);
    if (!result.artist && remaining.length) {
      const artistCandidate = remaining.find((text) => {
        const cellIndex = cellTexts.indexOf(text);
        if (cellIndex === -1) return false;
        const { isArtist } = detectByLabel(cells[cellIndex], text);
        return isArtist;
      });
      result.artist = artistCandidate || remaining[0];
    }
    if (!result.title && remaining.length > 1) {
      const remainingWithoutArtist = remaining.filter((text) => text !== result.artist);
      const titleCandidate = remainingWithoutArtist.find((text) => {
        const cellIndex = cellTexts.indexOf(text);
        if (cellIndex === -1) return false;
        const { isTitle } = detectByLabel(cells[cellIndex], text);
        return isTitle;
      });
      result.title =
        titleCandidate ||
        remainingWithoutArtist[0] ||
        remaining.find((text) => text !== result.artist) ||
        remaining[1] ||
        remaining[0];
    }

    return {
      isrc: result.isrc || 'N/A',
      artist: result.artist || 'N/A',
      title: result.title || 'N/A',
    };
  }

  function waitForStableRow(
    row,
    attempts = STABILITY_CHECKS,
    intervalMs = STABILITY_INTERVAL
  ) {
    return new Promise((resolve) => {
      if (!row) {
        resolve(null);
        return;
      }

      const totalAttempts = attempts;
      const interval = setInterval(() => {
        if (!row.isConnected) {
          clearInterval(interval);
          resolve(null);
          return;
        }

        const data = extractRowData(row);
        const isReady = data && data.isrc && data.isrc !== 'N/A';

        if (isReady) {
          clearInterval(interval);
          console.log(
            `[Coda Logger] Row stabilized after ${totalAttempts - attempts + 1} checks.`
          );
          resolve(data);
        } else if (--attempts <= 0) {
          clearInterval(interval);
          resolve(data || null);
        }
      }, intervalMs);
    });
  }

  function appendToMemory(entry, referenceDate = new Date()) {
    try {
      const context = getActiveLogContext(referenceDate);
      const raw = readStorage(context.logKey, '[]');
      let logEntries = [];

      if (raw) {
        try {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) {
            logEntries = parsed;
          }
        } catch (err) {
          console.warn('[Coda Logger] Existing log data was not valid JSON. Resetting.', err);
        }
      }

      logEntries.push(entry);
      writeStorage(context.logKey, JSON.stringify(logEntries));

      if (DEBUG) {
        console.log('[Coda Logger] Log entry stored.', {
          file: getActiveLogFile(referenceDate),
          windowStart: context.start,
          windowEnd: context.end,
          entry,
        });
      }
    } catch (err) {
      console.error('[Coda Logger] ERROR saving log:', err);
    }
  }

  function downloadLog() {
    const context = getActiveLogContext();
    const raw = readStorage(context.logKey, '[]');

    let logLines = [];
    try {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) {
        logLines = parsed.map(entry => {
          const date = new Date(entry.timestamp);
          const pad = n => String(n).padStart(2, '0');
          const stamp = `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
          return `${stamp} | ${entry.isrc} | ${entry.artist} | ${entry.title}`;
        });
      }
    } catch (err) {
      console.warn('[Coda Logger] Failed to parse log JSON for text export:', err);
    }

    const content = logLines.join('\n') || '(no entries logged yet)';
    const blob = new Blob([content], { type: 'text/plain' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `${context.fileName}.txt`;
    link.click();
    URL.revokeObjectURL(link.href);
  }

  function provideFeedback(button, trigger) {
    if (!button) return;
    const isNativeButton = button.tagName === 'BUTTON';
    if (!isNativeButton) {
      button.setAttribute('data-coda-task-logger-feedback', '1');
      button.style.outline = '2px solid #28a745';
      button.style.outlineOffset = '2px';
      setTimeout(() => {
        if (button.getAttribute('data-coda-task-logger-feedback')) {
          button.style.outline = '';
          button.style.outlineOffset = '';
          button.removeAttribute('data-coda-task-logger-feedback');
        }
      }, 1200);
      return;
    }

    const original = button.textContent;
    const originalBg = button.style.backgroundColor;
    button.textContent = trigger === 'take' ? '✅ Logged!' : '✅ Log saved';
    button.style.backgroundColor = '#28a745';
    setTimeout(() => {
      button.textContent = original;
      button.style.backgroundColor = originalBg;
    }, 2000);
  }

  function logTask(button, trigger) {
    console.log('[Coda Logger] logTask() called for trigger:', trigger);
    const row = findRowElement(button);
    if (!row) {
      console.error('[Coda Logger] ERROR: Could not find parent row element for the button.');
      return;
    }
    console.log('[Coda Logger] Found parent row element:', row);

    waitForStableRow(row).then((data) => {
      if (!data) {
        console.error('[Coda Logger] ERROR: Failed to extract row data after waiting for stability.');
        return;
      }

      if (data.isrc === 'N/A') {
        console.warn('[Coda Logger] WARNING: Row data stabilized but ISRC is still missing.');
      }

      const now = new Date();
      const line = `${ts(now)} | ${data.isrc} | ${data.artist} | ${data.title}`;
      console.log('[Coda Logger] SUCCESS: Data extracted:', line);
      GM_setClipboard(line);
      appendToMemory(
        {
          timestamp: now.toISOString(),
          isrc: data.isrc,
          artist: data.artist,
          title: data.title,
        },
        now
      );
      provideFeedback(button, trigger);
    });
  }

  // ---------- Core Logic ----------
  function handleClick(e) {
    const target = e.target;
    if (!target) return;

    // console.log('[Coda Logger] Click detected. Target:', target); // <-- Optional: very noisy

    const button = target.closest('button, [role="button"], [data-testid="canvas-view-row-action"], [data-testid="task-action-button"]');
    if (!button) {
      // This is normal, happens on every click that isn't a button
      return;
    }

    console.log('[Coda Logger] Found a potential button:', button);
    const text = normaliseWhitespace(button.innerText || button.textContent || '').toLowerCase();
    console.log('[Coda Logger] Button text is:', text);

    if (text === 'close task') {
  console.log('[Coda Logger] "Close task" button confirmed.');
  logTask(button, 'close');
}
  }

  // ---------- UI Button ----------
  function createDownloadButton() {
    if (!isTopLevelContext()) {
      return;
    }

    const existing = document.querySelector('[data-coda-task-logger="download"]');
    if (existing) return;

    const btn = document.createElement('button');
    btn.textContent = '📄 Download Log';
    btn.dataset.codaTaskLogger = 'download';
    Object.assign(btn.style, {
      position: 'fixed',
      bottom: '20px',
      right: '20px',
      background: '#1a73e8',
      color: '#fff',
      border: 'none',
      borderRadius: '8px',
      padding: '10px 16px',
      fontSize: '14px',
      fontWeight: '600',
      cursor: 'pointer',
      boxShadow: '0 2px 6px rgba(0,0,0,0.2)',
      zIndex: 999999,
    });
    btn.addEventListener('click', downloadLog);
    document.body.appendChild(btn);
  }

  function startLogger() {
    initializeFrameBridging();

    if (isTopLevelContext()) {
      setTimeout(createDownloadButton, 2000);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startLogger);
  } else {
    startLogger();
  }

  window.addEventListener('load', () => {
    initializeFrameBridging();

    if (isTopLevelContext()) {
      createDownloadButton();
    }
  });

    // ---------- CLEAR LOGS & NEW WEEK BUTTONS ----------
function clearCurrentLogs() {
  const context = getActiveLogContext();

  // Remove current log data
  writeStorage(context.logKey, '[]');

  // Optional: also reset saved window state
  writeStorage(WINDOW_STATE_KEY, '');

  alert(`✔️ Cleared logs for: ${context.fileName}`);
}

function startNewWeekLogs() {
  const now = new Date();

  // 1️⃣ Get current cycle boundaries for "now"
  const { end: currentCycleEnd } = getCurrentNMFWindow(now);

  // 2️⃣ The next cycle begins EXACTLY at the "end" timestamp
  const nextCycleStart = new Date(currentCycleEnd);

  // 3️⃣ File name = Friday immediately after cycle start
  const friday = new Date(nextCycleStart);
  friday.setDate(nextCycleStart.getDate() + 1); // Always +1 day for Friday

  const day = String(friday.getDate()).padStart(2, '0');
  const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'short' });
  const month = monthFormatter.format(friday);

  const fileName = `NMF-${day}${month}`;
  const logKey = `${LOG_KEY_PREFIX}${fileName}`;

  // 4️⃣ Compute next cycle end = 7 days after start
  const nextCycleEnd = new Date(nextCycleStart);
  nextCycleEnd.setDate(nextCycleStart.getDate() + 7);

  // 5️⃣ Reset storage for new week
  writeStorage(logKey, '[]');
  writeStorage(
    WINDOW_STATE_KEY,
    JSON.stringify({
      start: nextCycleStart.toISOString(),
      end: nextCycleEnd.toISOString(),
      fileName,
      logKey,
    })
  );

  alert(`🆕 Started new week log: ${fileName}`);
}

function createUtilityButtons() {
  if (!isTopLevelContext()) return;

  // Prevent duplication
  if (document.querySelector('[data-coda-task-logger="clear"]')) return;

  // --- Clear Logs Button ---
  const clearBtn = document.createElement('button');
  clearBtn.textContent = '🗑 Clear Logs';
  clearBtn.dataset.codaTaskLogger = 'clear';
  Object.assign(clearBtn.style, {
    position: 'fixed',
    bottom: '60px',
    right: '20px',
    background: '#d93025',
    color: '#fff',
    border: 'none',
    borderRadius: '8px',
    padding: '10px 16px',
    fontSize: '14px',
    fontWeight: '600',
    cursor: 'pointer',
    boxShadow: '0 2px 6px rgba(0,0,0,0.2)',
    zIndex: 999999,
  });
  clearBtn.addEventListener('click', clearCurrentLogs);
  document.body.appendChild(clearBtn);

  // --- Start New Week Button ---
  const newWeekBtn = document.createElement('button');
  newWeekBtn.textContent = '🆕 New Week';
  newWeekBtn.dataset.codaTaskLogger = 'newweek';
  Object.assign(newWeekBtn.style, {
    position: 'fixed',
    bottom: '100px',
    right: '20px',
    background: '#34a853',
    color: '#fff',
    border: 'none',
    borderRadius: '8px',
    padding: '10px 16px',
    fontSize: '14px',
    fontWeight: '600',
    cursor: 'pointer',
    boxShadow: '0 2px 6px rgba(0,0,0,0.2)',
    zIndex: 999999,
  });
  newWeekBtn.addEventListener('click', startNewWeekLogs);
  document.body.appendChild(newWeekBtn);
}

// Call them together with download button creator
if (isTopLevelContext()) {
  setTimeout(() => {
    createDownloadButton();
    createUtilityButtons();
  }, 2000);
}

})();
