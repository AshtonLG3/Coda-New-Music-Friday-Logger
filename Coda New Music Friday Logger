// ==UserScript==
// @name         Coda Task Logger (Memory + Manual Export)
// @namespace    mxm-tools
// @version      1.0.0
// @description  Stores Coda task logs in Tampermonkey memory and lets you download them anytime.
// @author       Richie
// @match        https://coda.io/d/Community-Shared*
// @grant        GM_setClipboard
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_download
// ==/UserScript==

(function () {
  'use strict';

  const LOG_KEY = 'coda_task_log';
  const LOG_FILENAME = 'CodaTaskLog.txt';

  // ---------- Helpers ----------
  const ts = () => {
    const d = new Date();
    const p = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
  };

  function normaliseWhitespace(value) {
    return (value || '').replace(/\s+/g, ' ').trim();
  }

  function findRowElement(element) {
    if (!element) return null;
    return (
      element.closest('tr') ||
      element.closest('[role="row"]') ||
      element.closest('[data-row-id]') ||
      element.closest('[data-testid="canvas-view-row"]') ||
      null
    );
  }

  function getRowCells(row) {
    if (!row) return [];
    const selectors = [
      '[role="gridcell"]',
      'td',
      '[data-column-id]',
      '[data-testid="canvas-view-cell"]',
      '[data-testid="tableColumnCell"]',
    ];

    for (const selector of selectors) {
      const cells = Array.from(row.querySelectorAll(selector));
      if (cells.length) {
        return cells;
      }
    }

    // Fallback: use direct children
    return Array.from(row.children || []);
  }

  function detectByLabel(cell, text) {
    const candidate = [
      cell?.dataset?.columnId,
      cell?.dataset?.columnName,
      cell?.dataset?.columnLabel,
      cell?.getAttribute('data-column-id'),
      cell?.getAttribute('data-column-label'),
      cell?.getAttribute('aria-label'),
      text,
    ]
      .map((value) => value || '')
      .join(' ')
      .toLowerCase();

    return {
      isISRC: candidate.includes('isrc') || /\bisrc\b/.test(candidate),
      isArtist: candidate.includes('artist'),
      isTitle: candidate.includes('title'),
    };
  }

  function extractRowData(row) {
    if (!row) return null;

    const cells = getRowCells(row);
    if (!cells.length) return null;

    const result = { isrc: '', artist: '', title: '' };

    const cellTexts = cells.map((cell) => normaliseWhitespace(cell.innerText || cell.textContent || ''));

    cells.forEach((cell, index) => {
      const text = cellTexts[index];
      if (!text) return;
      const { isISRC, isArtist, isTitle } = detectByLabel(cell, text);
      if (isISRC && !result.isrc) {
        result.isrc = text;
      } else if (isArtist && !result.artist) {
        result.artist = text;
      } else if (isTitle && !result.title) {
        result.title = text;
      }
    });

    const cleanedTexts = cellTexts.filter((text) => {
      if (!text) return false;
      if (/take\s+the\s+task/i.test(text)) return false;
      if (/close\s+task/i.test(text)) return false;
      if (/^\d+$/.test(text)) return false; // row index numbers
      return true;
    });

    const isrcPattern = /[A-Z]{2}-?[A-Z0-9]{3}-?\d{2}-?\d{5}/;
    if (!result.isrc) {
      const isrcCandidate = cleanedTexts.find((text) => isrcPattern.test(text.toUpperCase()));
      if (isrcCandidate) {
        result.isrc = isrcCandidate.toUpperCase();
      }
    }

    const remaining = cleanedTexts.filter((text) => text !== result.isrc);
    if (!result.artist && remaining.length) {
      result.artist = remaining[0];
    }
    if (!result.title && remaining.length > 1) {
      result.title = remaining[1];
    }

    return {
      isrc: result.isrc || 'N/A',
      artist: result.artist || 'N/A',
      title: result.title || 'N/A',
    };
  }

  function appendToMemory(line) {
    const old = GM_getValue(LOG_KEY, '');
    const newLog = old + line + '\n';
    GM_setValue(LOG_KEY, newLog);
  }

  function downloadLog() {
    const data = GM_getValue(LOG_KEY, '');
    const content = data.trim() || '(no entries logged yet)';
    GM_download({
      url: 'data:text/plain;charset=utf-8,' + encodeURIComponent(content),
      name: LOG_FILENAME,
      saveAs: true,
    });
  }

  function provideFeedback(button, trigger) {
    if (!button) return;
    const original = button.textContent;
    const originalBg = button.style.backgroundColor;
    button.textContent = trigger === 'take' ? '✅ Logged!' : '✅ Log saved';
    button.style.backgroundColor = '#28a745';
    setTimeout(() => {
      button.textContent = original;
      button.style.backgroundColor = originalBg;
    }, 2000);
  }

  function logTask(button, trigger) {
    const row = findRowElement(button);
    if (!row) return;

    // allow DOM to settle after the click
    setTimeout(() => {
      const data = extractRowData(row);
      if (!data) return;
      const line = `${ts()} | ${data.isrc} | ${data.artist} | ${data.title}`;
      GM_setClipboard(line);
      appendToMemory(line);
      provideFeedback(button, trigger);
    }, 120);
  }

  // ---------- Core Logic ----------
  function handleClick(e) {
    const target = e.target;
    if (!target) return;
    const button = target.closest('button');
    if (!button) return;

    const text = button.textContent.toLowerCase();
    if (text.includes('take') && text.includes('task')) {
      logTask(button, 'take');
    } else if (text.includes('close') && text.includes('task')) {
      logTask(button, 'close');
    }
  }

  document.addEventListener('click', handleClick);

  // ---------- UI Button ----------
  function createDownloadButton() {
    const existing = document.querySelector('[data-coda-task-logger="download"]');
    if (existing) return;

    const btn = document.createElement('button');
    btn.textContent = '📄 Download Log';
    btn.dataset.codaTaskLogger = 'download';
    Object.assign(btn.style, {
      position: 'fixed',
      bottom: '20px',
      right: '20px',
      background: '#1a73e8',
      color: '#fff',
      border: 'none',
      borderRadius: '8px',
      padding: '10px 16px',
      fontSize: '14px',
      fontWeight: '600',
      cursor: 'pointer',
      boxShadow: '0 2px 6px rgba(0,0,0,0.2)',
      zIndex: 999999,
    });
    btn.addEventListener('click', downloadLog);
    document.body.appendChild(btn);
  }

  window.addEventListener('load', () => setTimeout(createDownloadButton, 2000));
})();
